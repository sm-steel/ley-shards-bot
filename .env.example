# Copy to .env and fill in. Never commit the real .env.
# This file is used both by docker-compose (variable substitution + the
# bot container's env) and by the mariadb container (DB bootstrap vars).

# Telegram
BOT_TOKEN=
GACHA_TOPIC_ID=
ADMIN_USER_IDS=

# Optional. DEBUG/INFO/WARNING/ERROR — see CLAUDE.md's Logging section.
# Defaults to INFO if unset.
LOG_LEVEL=INFO

# Telegram API is unreachable directly from this host (moscow) — route through
# helsinki's tinyproxy.
TELEGRAM_PROXY_URL=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT

# Database — the bot connects to the "mariadb" service by its compose
# network hostname, not localhost.
DATABASE_URL=mysql+pymysql://ley_shards_bot:PASSWORD@mariadb:3306/ley_shards_bot

# MariaDB container bootstrap (must match the credentials embedded in
# DATABASE_URL above).
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATABASE=ley_shards_bot
MARIADB_USER=ley_shards_bot
MARIADB_PASSWORD=PASSWORD
